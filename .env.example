# ── 前端（Vite）──────────────────────────────────────────
# 开发：.env.development（npm run dev 自动加载）
# 生产：.env.production（npm run build 自动加载）
# 本地私密覆盖：.env.local / .env.*.local（勿提交）

# 播放 API 基址。开发留空用 Vite /api 代理；生产填完整 URL（含 /api）
VITE_API_BASE=
# 是否启用播放：1/true 开启，0/false 关闭
VITE_PLAYBACK=1

# Bangumi / AniList（公共接口通常无需 Token）
VITE_BANGUMI_API_BASE=https://api.bgm.tv
VITE_BANGUMI_ACCESS_TOKEN=
VITE_ANILIST_API_BASE=https://graphql.anilist.co
VITE_ANILIST_ACCESS_TOKEN=

# ── 后端（Render / 本机 process.env，不是 VITE_）────────
# PORT 由平台注入，本地默认 8787
# NODE_ENV=production
# CORS_ORIGIN=https://你的前端域名.com,http://localhost:5173
# PLAYBACK_DEBUG=0
# PLAYBACK_INTERCEPT_MS=16000
# PLAYBACK_PROVIDER_TIMEOUT_MS=28000
# PLAYBACK_CACHE_TTL_MS=600000
# PLAYBACK_WORK_CACHE_TTL_MS=1200000
# PLAYBACK_PROXY_HOSTS=
# PLAYBACK_RULES_DIR=

# 聚合弹幕（由 MioAni API 服务端访问，不要加 VITE_，token 不写入前端）
# DANMU_API_BASE=https://mioani-danmu-api.onrender.com
# TOKEN=部署 Logvr 服务时设置的 TOKEN（Render 服务使用的变量名）
# DANMU_API_TIMEOUT_MS=15000
# DANMU_API_RETRY_COUNT=5
# DANMU_API_RETRY_DELAY_MS=250
# DANMU_API_CACHE_TTL_MS=300000
# Logvr 的多来源配置需要在 Logvr 自己的 Render 服务中设置，以下变量不要填到 MioAni：
# Logvr 默认配置不会启用多源合并；如需多个来源，请在 Logvr 的服务配置中设置：
# SOURCE_ORDER=bilibili,dandan,animeko,tencent,youku,iqiyi,custom
# MERGE_SOURCE_PAIRS=bilibili&dandan&animeko&tencent&youku&iqiyi
# PLATFORM_ORDER=bilibili1,dandan,animeko,qq,youku,qiyi
# 如需完整抓取 B 站弹幕，可在 Logvr 服务中配置 BILIBILI_COOKIE。
# MERGE_SOURCE_PAIRS 使用 source 名称和 & 分隔；PLATFORM_ORDER 使用逗号分隔的 platform 名称。
# 以上变量和 BILIBILI_COOKIE 填到 Logvr 自己的 Render 服务；MioAni 只需要 DANMU_API_* 变量。
