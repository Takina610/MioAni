{
  "name": "anime",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c magenta,cyan \"npm:dev:api\" \"npm:dev:web\"",
    "dev:web": "vite",
    "dev:api": "node --env-file-if-exists=.env.local --import tsx --watch server/index.ts",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "start:api": "tsx server/index.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@phosphor-icons/vue": "^2.2.1",
    "artplayer": "^5.2.3",
    "artplayer-plugin-auto-thumbnail": "^1.1.0",
    "artplayer-plugin-danmuku": "^5.3.0",
    "artplayer-plugin-vtt-thumbnail": "^1.1.0",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "gsap": "^3.15.0",
    "hls.js": "^1.6.16",
    "pinia": "^3.0.4",
    "playwright": "^1.54.2",
    "vue": "^3.5.39",
    "vue-router": "^5.1.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24.13.2",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vue/tsconfig": "^0.9.1",
    "concurrently": "^10.0.3",
    "tsx": "^4.23.1",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.3.5"
  }
}
